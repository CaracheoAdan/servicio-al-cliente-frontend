# Browser-facing API base.
#
# Production builds: relative paths (/api/v1) are rewritten at runtime to
#   http(s)://<page-hostname>:5041/api/v1
# so the SPA site never handles /api (IIS 404.4 without ARR).
#
# Explicit options:
#   VITE_API_URL=same-host
#   VITE_API_URL=http://192.168.88.69:5041/api/v1
#   VITE_API_PORT=5041
#
VITE_API_URL=same-host
VITE_API_PORT=5041
